  "triggerEvents": [
    {
      "id": "trg-receipt-reset",
      "name": "Receipt Reset",
      "triggerConditions": [],
      "triggerEffects": [
        {
          "type": "effectRunScript",
          "data": "$receipt.turn = $game.turn_number\n$receipt.accepted = 0\n$receipt.message = \"No purchase requested.\"",
          "name": "Initialize This Turn Receipt",
          "id": "node-recipe-request-commit-1"
        }
      ],
      "triggerOnStartOfGame": true,
      "triggerMidGame": true,
      "canTriggerMoreThanOnce": true,
      "advancedLogic": false
    },
    {
      "id": "trg-purchase-request",
      "name": "Purchase Request",
      "triggerConditions": [
        {
          "category": "condition",
          "type": "triggerOnPawScript",
          "data": "$request.turn = $game.turn_number and $request.event = \"BUY_TICKET\"",
          "id": "node-recipe-request-commit-2"
        }
      ],
      "triggerEffects": [
        {
          "type": "effectRunScript",
          "data": "if $ticket = 1\n  $receipt.message = \"Ticket already owned; no charge.\"\nelse if $coins < 5\n  $receipt.message = \"Insufficient coins; no charge.\"\nelse\n  $coins -= 5\n  $ticket = 1\n  $receipt.accepted = 1\n  $receipt.message = \"Ticket purchased for 5 coins.\"",
          "name": "Validate and Purchase Ticket",
          "id": "node-recipe-request-commit-3"
        }
      ],
      "triggerOnStartOfGame": true,
      "triggerMidGame": true,
      "canTriggerMoreThanOnce": true,
      "advancedLogic": false
    },
    {
      "id": "trg-receipt-output",
      "name": "Receipt Output",
      "triggerConditions": [
        {
          "id": "trg-receipt-output-requested",
          "category": "condition",
          "type": "triggerOnPawScript",
          "data": "$request.turn = $game.turn_number and $request.event != \"NONE\""
        }
      ],
      "triggerEffects": [
        {
          "type": "effectShowMessage",
          "data": "<<$receipt.message>> Coins: <<$coins>>. Ticket: <<$ticket>>.",
          "id": "node-recipe-request-commit-4"
        },
        {
          "type": "effectRunScript",
          "data": "$request.turn = 0\n$request.event = \"NONE\"",
          "name": "Consume Purchase Request",
          "id": "node-recipe-request-commit-5"
        }
      ],
      "triggerOnStartOfGame": true,
      "triggerMidGame": true,
      "canTriggerMoreThanOnce": true,
      "advancedLogic": false
    }
  ],
